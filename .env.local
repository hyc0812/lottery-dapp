# Choose the chain by providing RPC + CHAIN_ID.
# Sepolia example (Infura/Alchemy/AMB endpoint):
# NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
# NEXT_PUBLIC_CHAIN_ID=11155111


# Local Ganache/Hardhat example:
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:7545
NEXT_PUBLIC_CHAIN_ID=1337


# Contract address of your deployed LotteryPool
NEXT_PUBLIC_CONTRACT_ADDRESS=0x4B904fBABBCfa079FA6632c333f231a976A3E278